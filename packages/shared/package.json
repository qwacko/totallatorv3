{
	"name": "@totallator/shared",
	"version": "0.0.1",
	"type": "module",
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"build": "tsc && tsc-alias",
		"dev": "tsc --watch & tsc-alias --watch",
		"clean": "rm -rf dist tsconfig.tsbuildinfo",
		"check": "tsc --noEmit",
		"circular": "madge --circular --extensions ts src/",
		"circular:graph": "madge --circular --extensions ts --image circular-deps.svg src/",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"prepack": "pnpm run build"
	},
	"dependencies": {
		"arktype": "^2.1.29",
		"lodash-es": "^4.17.23",
		"prettier": "^3.8.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/lodash-es": "^4.17.12",
		"madge": "^8.0.0",
		"tsc-alias": "^1.8.16",
		"typescript": "^5.9.3"
	}
}
