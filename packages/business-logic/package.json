{
	"name": "@totallator/business-logic",
	"version": "0.0.1",
	"type": "module",
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client.ts",
		"./*": "./src/*.ts"
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
		"dev": "tsc --watch --project tsconfig.build.json & tsc-alias --watch -p tsconfig.build.json",
		"clean": "rm -rf dist tsconfig.build.tsbuildinfo tsconfig.tsbuildinfo",
		"test": "vitest",
		"check": "tsc --project tsconfig.json",
		"circular": "madge --circular --extensions ts src/",
		"circular:graph": "madge --circular --extensions ts --image circular-deps.svg src/",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"knip": "knip",
		"prepack": "pnpm run build"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^3.0.31",
		"@ai-sdk/google": "^3.0.18",
		"@ai-sdk/groq": "^3.0.19",
		"@ai-sdk/openai": "^3.0.23",
		"@ai-sdk/xai": "^3.0.43",
		"@aws-sdk/client-s3": "^3.978.0",
		"@flystorage/aws-s3": "^1.2.0",
		"@flystorage/file-storage": "^1.2.2",
		"@flystorage/local-fs": "^1.2.0",
		"@node-rs/argon2": "^2.0.2",
		"@openrouter/ai-sdk-provider": "^2.1.1",
		"@opentelemetry/api": "^1.9.0",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@sveltejs/kit": "^2.50.1",
		"@totallator/context": "workspace:*",
		"@totallator/database": "workspace:*",
		"@totallator/shared": "workspace:*",
		"@types/papaparse": "^5.5.2",
		"ai": "^6.0.62",
		"akahu": "^2.4.0",
		"cronstrue": "^3.11.0",
		"devalue": "^5.6.2",
		"drizzle-orm": "^0.45.1",
		"handlebars": "^4.7.8",
		"lodash-es": "^4.17.23",
		"mathjs": "^15.1.0",
		"nanoid": "^5.1.6",
		"node-schedule": "^2.1.1",
		"papaparse": "^5.5.3",
		"postgres": "^3.4.8",
		"prettier": "^3.8.1",
		"sharp": "^0.34.5",
		"sql-formatter": "^15.7.0",
		"superjson": "^2.2.6",
		"undici-types": "^7.19.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^25.1.0",
		"@types/node-schedule": "^2.1.8",
		"@typescript/analyze-trace": "^0.10.1",
		"knip": "^5.82.1",
		"madge": "^8.0.0",
		"tsc-alias": "^1.8.16",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	}
}
