{
	"name": "@totallator/telemetry",
	"version": "0.0.1",
	"type": "module",
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"build": "tsc && tsc-alias",
		"dev": "tsc --watch & tsc-alias --watch",
		"clean": "rm -rf dist tsconfig.tsbuildinfo",
		"check": "tsc --noEmit",
		"circular": "madge --circular --extensions ts src/",
		"circular:graph": "madge --circular --extensions ts --image circular-deps.svg src/",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"prepack": "pnpm run build"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/api-logs": "^0.211.0",
		"@opentelemetry/core": "^2.5.0",
		"@opentelemetry/exporter-logs-otlp-http": "^0.211.0",
		"@opentelemetry/exporter-metrics-otlp-http": "^0.211.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.211.0",
		"@opentelemetry/instrumentation-http": "^0.211.0",
		"@opentelemetry/instrumentation-ioredis": "^0.59.0",
		"@opentelemetry/instrumentation-pino": "^0.57.0",
		"@opentelemetry/instrumentation-undici": "^0.21.0",
		"@opentelemetry/resources": "^2.5.0",
		"@opentelemetry/sdk-logs": "^0.211.0",
		"@opentelemetry/sdk-metrics": "^2.5.0",
		"@opentelemetry/sdk-node": "^0.211.0",
		"@opentelemetry/semantic-conventions": "^1.39.0",
		"bullmq-otel": "^1.3.0",
		"dotenv": "^17.2.3",
		"import-in-the-middle": "^2.0.6"
	},
	"devDependencies": {
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^25.1.0",
		"madge": "^8.0.0",
		"tsc-alias": "^1.8.16",
		"typescript": "^5.9.3"
	}
}
