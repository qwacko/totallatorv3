{
	"name": "@totallator/database",
	"version": "0.0.1",
	"type": "module",
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"build": "tsc && tsc-alias && cp -r src/migrations dist/",
		"dev": "tsc --watch & tsc-alias --watch",
		"clean": "rm -rf dist tsconfig.tsbuildinfo",
		"check": "tsc --noEmit",
		"circular": "madge --circular --extensions ts src/",
		"circular:graph": "madge --circular --extensions ts --image circular-deps.svg src/",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"db:generate": "tsx ./node_modules/drizzle-kit/bin.cjs generate --config=\"drizzle.config.ts\"",
		"db:test:generate": "tsx ./node_modules/drizzle-kit/bin.cjs generate --config=\"drizzle.test.config.ts\"",
		"db:test:migrator-probe": "tsx ./src/pgliteDrizzleMigratorProbe.ts",
		"db:studio": "tsx ./node_modules/drizzle-kit/bin.cjs studio --config=\"drizzle.config.ts\"",
		"db:custom": "tsx ./node_modules/drizzle-kit/bin.cjs generate --custom --config=\"drizzle.config.ts\"",
		"db:undo": "tsx ./node_modules/drizzle-kit/bin.cjs drop --config=\"drizzle.config.ts\"",
		"knip": "knip"
	},
	"dependencies": {
		"@electric-sql/pglite": "^0.3.16",
		"@kubiks/otel-drizzle": "^2.1.0",
		"@totallator/shared": "workspace:*",
		"@totallator/telemetry": "workspace:*",
		"drizzle-orm": "^0.45.1",
		"postgres": "^3.4.8",
		"prettier": "^3.8.1",
		"sql-formatter": "^15.7.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^25.1.0",
		"drizzle-kit": "^0.31.8",
		"knip": "^5.82.1",
		"madge": "^8.0.0",
		"tsx": "^4.21.0",
		"tsc-alias": "^1.8.16",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	}
}
