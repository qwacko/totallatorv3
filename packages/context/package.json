{
	"name": "@totallator/context",
	"version": "0.0.1",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc && tsc-alias",
		"dev": "tsc --watch & tsc-alias --watch",
		"check": "tsc --noEmit",
		"clean": "rm -rf dist tsconfig.tsbuildinfo",
		"circular": "madge --circular --extensions ts src/",
		"circular:graph": "madge --circular --extensions ts --image circular-deps.svg src/",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"dependencies": {
		"@opentelemetry/api": "^1.9.0",
		"@totallator/database": "workspace:*",
		"@totallator/log-database": "workspace:*",
		"@totallator/shared": "workspace:*",
		"pino": "^10.3.0",
		"pino-pretty": "^13.1.3"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.50.1",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^25.1.0",
		"madge": "^8.0.0",
		"prettier": "^3.8.1",
		"tsc-alias": "^1.8.16",
		"typescript": "^5.9.3"
	}
}
