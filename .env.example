DATABASE_FILE=./db.db
BACKUP_DIR=./backup/
IMPORT_DIR=./import/
BACKUP_SCHEDULE=0 0 * * *
ALLOW_SIGNUP=true
DB_QUERY_LOG=false
POSTGRES_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Redis Configuration for BullMQ
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# OpenTelemetry Configuration
OTEL_ENABLE_TRACING=false
OTEL_SERVICE_NAME=totallator
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318

# Loki Configuration
LOKI_ENABLE=false
LOKI_ENDPOINT=http://otel-lgtm:3100/loki/api/v1/push
LOKI_BATCH_SIZE=100
LOKI_FLUSH_INTERVAL=5000
# Long process / write lock controls
ENABLE_GLOBAL_WRITE_LOCK=false
LONG_PROCESS_LOCK_TTL_SECONDS=300
