{
	"name": "totallator-v3-monorepo",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm -r --filter='!@totallator/webapp' --filter='!@totallator/docs' build && pnpm --filter @totallator/webapp build",
		"dev": "pnpm --recursive --parallel --stream --filter @totallator/webapp --filter @totallator/worker dev",
		"dev:full": "pnpm --recursive --parallel --stream --filter='!@totallator/docs' dev",
		"clean": "pnpm --recursive clean",
		"webapp:dev": "pnpm --filter @totallator/webapp dev",
		"webapp:build": "pnpm --filter @totallator/webapp build",
		"webapp:preview": "pnpm --filter @totallator/webapp preview",
		"test": "pnpm --filter @totallator/webapp test",
		"test:integration": "pnpm --filter @totallator/webapp test:integration",
		"test:unit": "pnpm --filter @totallator/webapp  --workspace-concurrency=2  test:unit",
		"check": "pnpm --recursive --filter='!@totallator/docs' check",
		"check:watch": "pnpm --recursive --filter='!@totallator/docs' check:watch",
		"lint": "pnpm --recursive lint",
		"format": "pnpm --recursive format",
		"lint:webapp": "pnpm --filter @totallator/webapp lint",
		"format:webapp": "pnpm --filter @totallator/webapp format",
		"db:generate": "pnpm --filter @totallator/database db:generate",
		"db:studio": "pnpm --filter @totallator/database db:studio",
		"docs:dev": "pnpm --filter @totallator/docs dev",
		"docs:build": "pnpm --filter @totallator/docs build",
		"docs:preview": "pnpm --filter @totallator/docs preview",
		"circular": "pnpm --recursive circular",
		"circular:business-logic": "pnpm --filter @totallator/business-logic circular",
		"circular:webapp": "pnpm --filter @totallator/webapp circular",
		"circular:shared": "pnpm --filter @totallator/shared circular",
		"circular:database": "pnpm --filter @totallator/database circular",
		"circular:context": "pnpm --filter @totallator/context circular",
		"worker:dev": "pnpm --filter @totallator/worker dev",
		"worker:build": "pnpm --filter @totallator/worker build",
		"worker:check": "pnpm --filter @totallator/worker check",
		"typecheck": "pnpm check",
		"dev:root": "pnpm dev"
	},
	"devDependencies": {
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"typescript": "^5.9.3"
	}
}
