{
	"name": "@totallator/worker",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch --tsconfig tsconfig.json src/main.ts",
		"build": "tsc --project tsconfig.build.json",
		"check": "tsc --project tsconfig.json",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"check:watch": "tsc --project tsconfig.json --watch"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.978.0",
		"@flystorage/aws-s3": "^1.2.0",
		"@flystorage/file-storage": "^1.2.2",
		"@flystorage/local-fs": "^1.2.0",
		"@libsql/client": "^0.17.0",
		"@totallator/bullmq": "workspace:*",
		"@totallator/business-logic": "workspace:*",
		"@totallator/context": "workspace:*",
		"@totallator/database": "workspace:*",
		"@totallator/shared": "workspace:*",
		"bullmq": "^5.67.2",
		"dotenv": "^17.2.3",
		"drizzle-orm": "^0.45.1",
		"ioredis": "^5.9.2",
		"nanoid": "^5.1.6"
	},
	"devDependencies": {
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^25.1.0",
		"prettier": "^3.8.1",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3"
	}
}
