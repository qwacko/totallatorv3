{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"declaration": false,
		"baseUrl": "./",
		"paths": {
			"@/*": ["../../packages/business-logic/src/*"],
			"@totallator/business-logic": ["../../packages/business-logic/src/index.ts"],
			"@totallator/log-database": ["../../packages/logDatabase/src/index.ts"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["dist", "node_modules"]
}
